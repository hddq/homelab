{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "kubernetes": {
    "enabled": true,
    "managerFilePatterns": ["/kubernetes/.+\\.yaml$/"]
  },
  "nix": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["on monday", "on friday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["ansible/playbooks/proxmox/monitoring.yaml"],
      "matchStrings": ["node_exporter_version: \"(?<currentValue>[\\d.]+)\""],
      "depNameTemplate": "prometheus/node_exporter",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["kubernetes/clusters/homelab/apps/**/deployment.yaml"],
      "matchStrings": ["PLUGIN_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "J0R6IT0/navidrome-lyrics-plugin",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["\\.github/workflows/ci-python\\.yaml$"],
      "matchStrings": ["version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "astral-sh/ruff",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchFileNames": ["kubernetes/clusters/homelab/apps/**", "kubernetes/clusters/homelab/infra/**"],
      "pinDigests": true
    },
    {
      "matchFileNames": ["ansible/**"],
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "groupName": "Patch ansible"
    },
    {
      "matchFileNames": ["ansible/**"],
      "matchUpdateTypes": ["minor"],
      "groupName": "Minor ansible"
    },

    {
      "matchFileNames": ["kubernetes/clusters/homelab/apps/**"],
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "groupName": "Patch apps"
    },
    {
      "matchFileNames": ["kubernetes/clusters/homelab/apps/**"],
      "matchUpdateTypes": ["minor"],
      "groupName": "Minor apps"
    },

    {
      "matchFileNames": ["kubernetes/clusters/homelab/infra/**"],
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "groupName": "Patch infrastructure"
    },
    {
      "matchFileNames": ["kubernetes/clusters/homelab/infra/**"],
      "matchUpdateTypes": ["minor"],
      "groupName": "Minor infrastructure"
    },

    {
      "matchFileNames": [".github/**"],
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "groupName": "Patch ci"
    },
    {
      "matchFileNames": [".github/**"],
      "matchUpdateTypes": ["minor"],
      "groupName": "Minor ci"
    },
    {
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "automerge": true,
      "schedule": ["on monday", "on friday"]
    }
  ]
}
