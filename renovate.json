{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "kubernetes": {
    "enabled": true,
    "managerFilePatterns": ["/apps/.+\\.yaml$/", "/infrastructure/.+\\.yaml$/"]
  },
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["k3s_version.txt"],
      "matchStrings": ["(?<currentValue>v\\S+)"],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["ansible/requirements.yaml"],
      "matchStrings": [
        "# proxy-version-for-renovate: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "community.proxmox",
      "datasourceTemplate": "galaxy-collection"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["ansible/playbooks/proxmox/monitoring.yaml"],
      "matchStrings": ["node_exporter_version: \"(?<currentValue>[\\d.]+)\""],
      "depNameTemplate": "prometheus/node_exporter",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["apps/**/deployment.yaml"],
      "matchStrings": ["PLUGIN_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "J0R6IT0/navidrome-lyrics-plugin",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchFileNames": ["apps/**", "infrastructure/**"],
      "pinDigests": true
    },
    {
      "matchFileNames": ["ansible/**"],
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "groupName": "Patch ansible"
    },
    {
      "matchFileNames": ["ansible/**"],
      "matchUpdateTypes": ["minor"],
      "groupName": "Minor ansible"
    },

    {
      "matchFileNames": ["apps/**"],
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "groupName": "Patch apps"
    },
    {
      "matchFileNames": ["apps/**"],
      "matchUpdateTypes": ["minor"],
      "groupName": "Minor apps"
    },

    {
      "matchFileNames": ["infrastructure/**"],
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "groupName": "Patch infrastructure"
    },
    {
      "matchFileNames": ["infrastructure/**"],
      "matchUpdateTypes": ["minor"],
      "groupName": "Minor infrastructure"
    },

    {
      "matchFileNames": [".github/**"],
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "groupName": "Patch ci"
    },
    {
      "matchFileNames": [".github/**"],
      "matchUpdateTypes": ["minor"],
      "groupName": "Minor ci"
    }
  ]
}
