{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^ansible/vars/k3s_cluster\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.*k3s_version: \"(?<currentValue>.*?)\""
      ]
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/ci-k8s\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) extractVersion=(?<extractVersion>\\S+)\\n.*--target-versions k8s=(?<currentValue>\\S+)"
      ]
    }
  ]
}